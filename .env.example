# Sense Platform — configuration. Copy to .env and fill in.
#   cp .env.example .env

# ---- API ----
# Shared secret the device sends as the X-API-Key header on /ingest.
# Generate one:  openssl rand -hex 24
SENSE_API_KEY=change-me-to-a-long-random-string
# Quote values containing spaces (the setup scripts source this file).
SITE_NAME="Sense Platform"
# Port the dashboard + API are published on (http://localhost:<API_PORT>).
API_PORT=8000
# Default timezone for human-readable reading timestamps.
DEFAULT_TIMEZONE=Australia/Brisbane
# CORS: "*" is fine because the dashboard is served same-origin by the API.
CORS_ORIGINS=*

# ---- Database (the db service) ----
PGUSER=sense
PGPASSWORD=change-me-too
PGDATABASE=sense

# ---- AI layer ----
# Required for the embedding pipeline and the /ask endpoint.
#   OPENAI_API_KEY    -> reading embeddings + vector search
#   ANTHROPIC_API_KEY -> /ask answer generation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Remote access (Cloudflare Tunnel) — optional ----
# Token from a Cloudflare Zero Trust tunnel whose public hostname points at
# http://api:8000. Only used with:  docker compose --profile tunnel up -d
TUNNEL_TOKEN=
